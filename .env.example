# ==============================================================================
# AURELIA RESTAURANT OS - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment (development | production)
APP_ENV=production
LOG_LEVEL=INFO

# Application URLs
APP_URL=https://app.aureliaos.com
FRONTEND_URL=https://app.aureliaos.com
BACKEND_URL=https://api.aureliaos.com

# Database Connection
# Local Development (SQLite): sqlite:///./aurelia.db
# Production (Managed PostgreSQL): postgresql://user:password@host:5432/aurelia_os
DATABASE_URL=postgresql://aurelia_user:your_strong_db_password_here@localhost:5432/aurelia_os

# Cryptographic Keys (Generate with `openssl rand -hex 32`)
SECRET_KEY=replace_with_a_cryptographically_secure_random_key_64_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Security & CORS
SESSION_COOKIE_SECURE=true
ALLOWED_ORIGINS=https://app.aureliaos.com,https://api.aureliaos.com

# File & Image Storage (local | s3 | cloud_storage)
UPLOAD_STORAGE=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET_NAME=

# Optional Notification Integrations
# Status: Unconfigured by default. Configure valid API keys before activating.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key_here
EMAIL_FROM_ADDRESS=noreply@aureliaos.com

# Optional Payment Gateway
# Status: Pay-at-counter enabled by default. Add provider credentials for gateway processing.
PAYMENT_PROVIDER=unconfigured
RAZORPAY_KEY_ID=rzp_live_placeholder
RAZORPAY_KEY_SECRET=razorpay_secret_placeholder
STRIPE_PUBLISHABLE_KEY=pk_live_placeholder
STRIPE_SECRET_KEY=sk_live_placeholder

# Redis Cache & Shared Event Broker (Required only for multi-instance horizontal scaling)
REDIS_URL=redis://localhost:6379/0
